---
interface Props {
  label: string;
  command: string;
}

const { label, command } = Astro.props;
---

<div class="command">
  <div class="command__text">
    <p class="step__label"><span class="step__text">{label}</span></p>
    <pre class="command__code"><code>{command}</code></pre>
  </div>
  <button type="button" class="command__copy no-print" data-copy={command} aria-label={`Copy the command: ${label}`}><span class="command__copy-label" data-copy-label>Copy</span></button>
</div>

<style>
  .command {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--gutter);
    align-items: center;
  }

  .command__text {
    min-width: 0;
  }

  .command__copy {
    position: relative;
    display: inline-grid;
    justify-items: center;
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: inset 0 0 0 1px var(--cobalt);
    color: var(--cobalt);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .command__copy::before,
  .command__copy-label {
    grid-area: 1 / 1;
  }

  .command__copy::before {
    content: "Copied";
    visibility: hidden;
  }

  .command__copy::after {
    content: "";
    position: absolute;
    inset: -0.5rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .command__copy:hover {
      background: var(--cobalt);
      color: var(--paper);
    }
  }

  .command__copy:active {
    transform: scale(0.97);
  }

  .command__copy[data-state="copied"] {
    background: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
    color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .command__copy {
      transition:
        background-color 160ms var(--ease-out),
        color 160ms var(--ease-out);
    }

    .command__copy:active {
      transform: none;
    }
  }

  .command__code {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .command__code code {
    font-size: 1em;
  }
</style>
