---
interface Props {
  number: string;
  id: string;
  title: string;
}

const { number, id, title } = Astro.props;
---

<header class="section-head grid">
  <p class="numeral" aria-hidden="true">{number}</p>
  <div class="section-head__text">
    <h2 id={id}>{title}</h2>
    <div class="section-head__intro">
      <slot />
    </div>
  </div>
</header>

<style>
  .section-head {
    align-items: start;
    row-gap: var(--space-md);
    margin-block-end: var(--space-xl);
  }

  .numeral {
    grid-column: 1 / span 3;
    margin-inline-start: -0.033em;
    letter-spacing: -0.05em;
  }

  .section-head__text {
    grid-column: 4 / span 8;
    display: grid;
    gap: var(--space-md);
    padding-block-start: var(--line);
  }

  h2 {
    font-size: var(--step-4);
    --lh: var(--lh-big);
    letter-spacing: -0.025em;
    max-width: 20ch;
  }

  .section-head__intro :global(p) {
    font-size: var(--step-lede);
    max-width: 24em;
    color: var(--ink-muted);
  }

  @media (max-width: 48rem) {
    .numeral,
    .section-head__text {
      grid-column: 1 / -1;
    }

    .section-head__text {
      padding-block-start: 0;
    }
  }
</style>
