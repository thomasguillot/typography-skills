---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Command from '../components/Command.astro';

const repo = 'https://github.com/thomasguillot/typography-skills';

const specimen =
  'The storm had been building since noon. By the time Elias climbed the ninety-two steps to the lamp room, the sea below was a churning field of white, and the wind threw rain against the glass in long, hissing sheets. He checked the wick, trimmed it, and settled into the chair he had sat in for twenty-three years.';

const contexts = [
  ['Dense product UI, dashboards, data tables', 'Major second 1.125 to minor third 1.2', 'Many levels in little space; weight and color carry hierarchy.'],
  ['Docs, long-form reading, most websites', 'Major third 1.25', 'Clear headings without shouting.'],
  ['Editorial, marketing, landing pages', 'Perfect fourth 1.333', 'Strong contrast, room for display sizes.'],
  ['Posters, portfolios, display-led brands', 'Perfect fifth 1.5 or golden 1.618', 'Dramatic jumps, so fewer steps. They outgrow small screens fast.'],
  ['Books and long print documents', 'Minor third 1.2', 'Text-led; headings stay near the body.'],
];

const compare = [
  ['5xl', '68.66', '100.98', '322.96'],
  ['4xl', '54.93', '75.76', '199.6'],
  ['3xl', '43.95', '56.83', '123.36'],
  ['2xl', '35.16', '42.63', '76.24'],
  ['xl', '28.13', '31.98', '47.12'],
  ['lg', '22.5', '23.99', '29.12'],
  ['base', '18', '18', '18'],
  ['sm', '16', '16', '16'],
  ['xs', '14.22', '14.22', '14.22'],
];

const gridScale = [
  ['5xl', '100.98', '108', 'Display'],
  ['4xl', '75.76', '81', 'h1'],
  ['3xl', '56.83', '67.5, half line', 'h2'],
  ['2xl', '42.63', '54', 'h3'],
  ['xl', '31.98', '40.5, half line', 'h4'],
  ['lg', '23.99', '27', 'h5, lede'],
  ['base', '18', '27', 'h6, body'],
  ['sm', '16', '27', 'Small'],
  ['xs', '14.22', '27', 'Label'],
];

const habits = [
  ['Body text at 16px or more, in rem', 'Points are correct. Book text runs 9.5 to 11.5pt; 16px is 12pt, large on paper.'],
  ['Unitless line-height', 'Leading is absolute, 10.5 on 14pt, and it sets the baseline grid.'],
  ['Avoid justified text', 'Justified with hyphenation is the book default. Flag it only without hyphens.'],
  ['A soft near-black for comfort', 'Body text is 100% black ink. A gray prints as a tint or a four-color mix.'],
  ['A good fallback font stack', 'There is no fallback. A missing font prints in the wrong face.'],
];

const families = [
  { count: 27, name: 'Shared', scope: 'Hierarchy, proximity, paragraphs, true italics and bolds, quotes and dashes, tracking, figures, optical alignment.' },
  { count: 34, name: 'Web', scope: 'Units, leading, measure, font loading, rendered fonts, WCAG and APCA contrast, dark mode, links.' },
  { count: 37, name: 'Print', scope: 'Page format and margins, baseline grid, size and leading, justification, print stylesheets, ink and bleed.' },
  { count: 9, name: 'PDF', scope: 'PDF/X, trim and bleed boxes, font embedding, tagging for screen readers.' },
];

const tools = [
  {
    file: 'extract-web-type.js',
    reads: 'Runs inside the page.',
    body: 'Returns the face that actually rendered, sizes, leading ratios, characters per line, WCAG and APCA contrast, and where the ink sits for every text role, in every color scheme.',
  },
  {
    file: 'inspect-pdf.py',
    reads: 'Reads the file, not a picture of it.',
    body: 'Page boxes, embedded fonts, PDF/X intent, color operators, body size, leading and measure. It caught Minion Pro silently replaced by Times, and #333 text that would print as a four-color gray.',
  },
  {
    file: 'contrast.mjs',
    reads: 'For reviews without a browser.',
    body: 'WCAG 2 ratio and APCA Lc for any pair of colors, with thresholds that scale with size and weight.',
  },
];
---

<Base
  title="typography-skills: typography review and type scales for coding agents"
  description="Two agent skills for typography. typography-check reviews web pages, stylesheets, print layouts and PDFs. typography-scale builds a type scale for what you are making, snapped to a baseline grid."
>
  <header class="masthead page">
    <div class="grid masthead__bar">
      <p class="wordmark">typography-skills</p>
      <nav class="masthead__nav" aria-label="Site">
        <p class="masthead__links"><button type="button" class="grid-toggle no-print" aria-pressed="false" data-grid-toggle>Show grid</button><a href={repo}>GitHub</a></p>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero page" aria-labelledby="hero-title">
      <div class="grid">
        <h1 id="hero-title" class="hero__title">
          Type has rules. <span class="hero__accent">Web has some, print has others.</span>
        </h1>
        <p class="hero__lede">
          Two agent skills for typography. <strong>typography-check</strong> reviews web pages, stylesheets, print layouts and PDFs, measuring what actually renders. <strong>typography-scale</strong> builds a type scale for what you are making, snapped to a baseline grid.
        </p>
        <div class="hero__action">
          <a class="button" href={repo}>Get them on GitHub</a>
          <p class="label">Works with Claude Code and any agent that reads SKILL.md.</p>
        </div>
      </div>
    </section>

    <section class="section page" aria-labelledby="medium">
      <SectionHead number="01" id="medium" title="The medium decides the rules">
        <p>Ten-point justified text with fixed leading is right in a book and wrong on a web page. typography-check identifies the medium before it judges anything.</p>
      </SectionHead>

      <div class="grid specimens">
        <figure class="specimen specimen--web">
          <figcaption>
            <p class="specimen__title">Web</p>
            <dl class="specs">
              <div><dt>Size</dt><dd>18px</dd></div>
              <div><dt>Line height</dt><dd>1.5, a 27px baseline</dd></div>
              <div><dt>Measure</dt><dd>30em, about 63 characters</dd></div>
              <div><dt>Setting</dt><dd>Ragged right</dd></div>
            </dl>
          </figcaption>
          <div class="specimen__surface">
            <p lang="en">{specimen}</p>
          </div>
        </figure>

        <figure class="specimen specimen--print">
          <figcaption>
            <p class="specimen__title">Print</p>
            <dl class="specs">
              <div><dt>Size</dt><dd>10pt</dd></div>
              <div><dt>Leading</dt><dd>13pt, absolute</dd></div>
              <div><dt>Page</dt><dd>129 × 198mm</dd></div>
              <div><dt>Setting</dt><dd>Justified, hyphenated</dd></div>
            </dl>
          </figcaption>
          <div class="specimen__surface">
            <div class="page-sheet">
              <p lang="en">{specimen}</p>
            </div>
          </div>
        </figure>
      </div>

      <div class="grid data">
        <h3 class="data__title">Web habits that are wrong in print</h3>
        <table class="data__table">
          <thead>
            <tr><th scope="col">On the web</th><th scope="col">On paper</th></tr>
          </thead>
          <tbody>
            {habits.map(([web, print]) => (
              <tr><th scope="row">{web}</th><td>{print}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section page" aria-labelledby="checks">
      <SectionHead number="02" id="checks" title="107 rules, in four families">
        <p>Each rule has an ID, a threshold, a fix and a severity, paraphrased from the Typography Handbook’s web and print editions.</p>
      </SectionHead>

      <ol class="families grid" role="list">
        {families.map((family) => (
          <li class="family">
            <p class="family__count" aria-hidden="true">{family.count}</p>
            <h3 class="family__name">{family.name} <span class="visually-hidden">({family.count} rules)</span></h3>
            <p class="family__scope">{family.scope}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section page" aria-labelledby="report">
      <SectionHead number="03" id="report" title="A report you can act on">
        <p>Every finding names the rule, the place, the measured value and the fix. Severity comes from the rule, not from mood.</p>
      </SectionHead>

      <div class="grid">
        <figure class="report">
          <div class="report__doc">
            <p class="report__heading">Typography check: Tidewater landing page</p>
            <p class="report__meta">Medium: web, from a URL with a viewport meta and woff2 fonts. Measured in the page at 1280px and 375px, light and dark.</p>

            <p class="report__severity"><span class="sev sev--p0">P0</span> Broken</p>
            <ul class="findings">
              <li><code>web/rendered-font</code> All four Satoshi files return 404, so every role renders in the browser default face.</li>
              <li><code>web/leading-overlap</code> <span class="where">h1</span> Line height 22px on 72px type, a ratio of 0.31. Wrapped lines overlap. Fix: <code>line-height: 1.1</code>.</li>
              <li><code>web/zoom</code> <span class="where">viewport</span> <code>user-scalable=no</code> blocks pinch zoom.</li>
            </ul>

            <p class="report__severity"><span class="sev sev--p1">P1</span> Readability and accessibility</p>
            <ul class="findings">
              <li><code>web/contrast</code> <span class="where">.feature p</span> #9a9a9a on white is 2.81:1, below AA. APCA gives Lc 54 against the 90 it needs at 14px.</li>
              <li><code>web/contrast</code> <span class="where">links, dark mode</span> #0a66ff on black is 4.36:1. The same link passes in light mode.</li>
              <li><code>web/measure</code> <span class="where">.story p</span> About 162 characters per line at 1280px, against 45 to 75.</li>
              <li><code>web/one-family-name</code> Each weight is its own family, so headings get a synthesized bold.</li>
            </ul>
            <p class="report__more">Then ten numbered craft findings, and one line for the rest.</p>
          </div>
          <figcaption class="label">Excerpt from a check of a test landing page built with deliberate faults.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section page" aria-labelledby="measured">
      <SectionHead number="04" id="measured" title="Measured, not guessed">
        <p>Declared is not rendered. Three small scripts report what the reader actually gets.</p>
      </SectionHead>

      <div class="grid tools">
        {tools.map((tool) => (
          <article class="tool">
            <h3 class="tool__file"><code>{tool.file}</code></h3>
            <p class="tool__reads">{tool.reads}</p>
            <p class="tool__body">{tool.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section page" aria-labelledby="contrast">
      <SectionHead number="05" id="contrast" title="Two contrast models, both reported">
        <p>WCAG 2 is the compliance check. APCA, proposed for WCAG 3, accounts for size, weight and polarity.</p>
      </SectionHead>

      <div class="grid contrast">
        <figure class="swatch">
          <div class="swatch__sample">
            <p class="swatch__big" aria-hidden="true">Aa</p>
            <p class="swatch__text">Gray body text at 15 pixels, regular weight, on white.</p>
          </div>
          <figcaption class="label">#767676 on #ffffff, 15px, weight 400.</figcaption>
        </figure>

        <div class="verdicts">
          <dl class="verdicts__list">
            <div class="verdict">
              <dt>WCAG 2</dt>
              <dd><p class="verdict__value">4.54:1</p><p>Passes AA, which needs 4.5.</p></dd>
            </div>
            <div class="verdict">
              <dt>APCA</dt>
              <dd><p class="verdict__value">Lc 71.6</p><p>Fails. Body text this small needs 90.</p></dd>
            </div>
          </dl>
          <p class="verdicts__note">When the two disagree, the report says so and gives both numbers. APCA usually points to the better fix: more size, more weight or more contrast.</p>
        </div>
      </div>
    </section>

    <section class="section page" aria-labelledby="scale">
      <SectionHead number="06" id="scale" title="A scale chosen for the context">
        <p>typography-scale asks what you are making, proposes two or three ratios, and shows them side by side before it generates anything.</p>
      </SectionHead>

      <div class="grid data">
        <h3 class="data__title">Context and ratio</h3>
        <table class="data__table">
          <thead>
            <tr><th scope="col">Making</th><th scope="col">Ratio</th><th scope="col">Why</th></tr>
          </thead>
          <tbody>
            {contexts.map(([making, ratio, why]) => (
              <tr><th scope="row">{making}</th><td>{ratio}</td><td>{why}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="grid data">
        <h3 class="data__title">Same 18px body, three ratios</h3>
        <table class="data__table data__table--numbers">
          <thead>
            <tr><th scope="col">Step</th><th scope="col">Major third 1.25</th><th scope="col">Perfect fourth 1.333</th><th scope="col">Golden 1.618</th></tr>
          </thead>
          <tbody>
            {compare.map(([step, a, b, c]) => (
              <tr><th scope="row">{step}</th><td>{a}px</td><td>{b}px</td><td>{c}px</td></tr>
            ))}
          </tbody>
        </table>
        <p class="data__note">Golden reaches 323px by 5xl, so the skill suggests fewer steps for it. Steps below the body use a gentler 1.125, so small text stays readable.</p>
      </div>
    </section>

    <section class="section page" aria-labelledby="grid-scale">
      <SectionHead number="07" id="grid-scale" title="Leading on the grid">
        <p>Sizes come from the ratio. Leading rounds to whole lines of the baseline grid, or to half lines where a whole line would be loose.</p>
      </SectionHead>

      <div class="grid data">
        <h3 class="data__title">Perfect fourth on a 27px grid</h3>
        <table class="data__table data__table--numbers">
          <thead>
            <tr><th scope="col">Step</th><th scope="col">Size</th><th scope="col">Leading</th><th scope="col">Role</th></tr>
          </thead>
          <tbody>
            {gridScale.map(([step, size, leading, role]) => (
              <tr><th scope="row">{step}</th><td>{size}px</td><td>{leading.replace(/^([\d.]+)/, '$1px')}</td><td>{role}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="data__note">The same scale comes out as CSS custom properties, JSON, Tailwind theme values, or a print spec such as body 10.5/14pt. The 27px grid is the one this page is set on.</p>
      </div>
    </section>

    <section class="section page" aria-labelledby="install">
      <SectionHead number="08" id="install" title="Install">
        <p>Plain files: two SKILL.md files, rule references and four scripts. MIT licensed.</p>
      </SectionHead>

      <ol class="steps grid" role="list">
        <li class="step">
          <Command label="Clone the repository" command={`git clone ${repo}.git`} />
        </li>
        <li class="step">
          <Command label="Link both skills into your agent’s skills folder" command={'ln -s "$PWD/typography-skills/typography-check" "$PWD/typography-skills/typography-scale" ~/.claude/skills/'} />
        </li>
        <li class="step">
          <Command label="For PDFs, install qpdf and Ghostscript" command="brew install qpdf ghostscript" />
        </li>
        <li class="step">
          <p class="step__label"><span class="step__text">Ask your agent</span></p>
          <p class="step__ask">“Check the typography of https://example.com”, or point it at a folder of CSS, a print stylesheet or a PDF.</p>
          <p class="step__ask">“Make a type scale for a docs site with an 18px body”, or for a book, a dashboard or a landing page.</p>
        </li>
      </ol>
    </section>
  </main>

  <footer class="footer page">
    <div class="grid">
      <div class="footer__credits">
        <h2 class="footer__title">Sources and credits</h2>
        <ul role="list">
          <li>Rules paraphrased from the <a href="https://typographyhandbook.com">Typography Handbook</a> and its <a href="https://typographyhandbook.com/print/">print edition</a>, based on Kenneth Wang’s original, MIT license.</li>
          <li>Report format adapted from <a href="https://github.com/mblode/agent-skills">mblode/agent-skills</a>, MIT license.</li>
          <li>APCA constants from the APCA-W3 0.0.98G reference.</li>
        </ul>
      </div>
      <p class="footer__colophon label">Set in Schibsted Grotesk on a twelve-column grid. MIT license. <a href={repo}>Source on GitHub</a>.</p>
    </div>
  </footer>

  <p class="visually-hidden" aria-live="polite" data-status></p>
</Base>

<script>
  const status = document.querySelector<HTMLElement>('[data-status]');
  const announce = (message: string) => {
    if (status) status.textContent = message;
  };

  const toggle = document.querySelector<HTMLButtonElement>('[data-grid-toggle]');
  const syncToggle = () => {
    const on = document.documentElement.dataset.grid === 'on';
    toggle?.setAttribute('aria-pressed', String(on));
  };
  syncToggle();
  toggle?.addEventListener('click', () => {
    const on = document.documentElement.dataset.grid !== 'on';
    if (on) document.documentElement.dataset.grid = 'on';
    else delete document.documentElement.dataset.grid;
    try {
      localStorage.setItem('grid', on ? 'on' : 'off');
    } catch {}
    syncToggle();
    announce(on ? 'Grid shown' : 'Grid hidden');
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    const setLabel = (text: string) => {
      if (label) label.textContent = text;
    };
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        setLabel('Copied');
        button.dataset.state = 'copied';
        announce('Command copied');
      } catch {
        setLabel('Select');
        announce('Copy failed. Select the command and copy it manually.');
      }
      window.setTimeout(() => {
        setLabel('Copy');
        delete button.dataset.state;
      }, 2000);
    });
  });
</script>

<style>
  .masthead__bar {
    align-items: start;
    padding-block: var(--line);
    box-shadow: inset 0 -1px 0 var(--ink);
  }

  .wordmark {
    grid-column: 1 / span 6;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .masthead__nav {
    grid-column: 7 / -1;
  }

  .masthead__links {
    text-align: end;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .masthead__links a {
    margin-inline-start: var(--space-lg);
  }

  .grid-toggle {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    color: var(--cobalt);
    font: inherit;
    line-height: inherit;
    cursor: pointer;
  }

  .grid-toggle::after {
    content: "";
    position: absolute;
    inset: -0.75rem -0.5rem;
  }

  .grid-toggle[aria-pressed="true"] {
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.2em;
  }

  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hero .grid {
    row-gap: var(--space-xl);
  }

  .hero__title {
    grid-column: 1 / span 11;
    font-size: var(--display);
    font-weight: 800;
    --lh: var(--lh-big);
    letter-spacing: -0.045em;
  }

  .hero__accent {
    color: var(--cobalt);
  }

  .hero__lede {
    grid-column: 1 / span 6;
    font-size: var(--step-lede);
    max-width: 24em;
  }

  .hero__action {
    grid-column: 8 / span 5;
    align-self: end;
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: calc(var(--line) * 2);
    padding-inline: var(--inset);
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .button:hover {
      background: var(--cobalt);
    }
  }

  .button:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: background-color 160ms var(--ease-out);
    }

    .button:active {
      transform: none;
    }
  }

  .section,
  .footer {
    background: linear-gradient(var(--ink), var(--ink)) center top / calc(100% - 2 * var(--margin)) 1px no-repeat;
  }

  .section {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .specimens {
    row-gap: var(--space-xl);
  }

  .specimen {
    display: grid;
    align-content: start;
    gap: var(--space-md);
  }

  .specimen--web {
    grid-column: 1 / span 6;
  }

  .specimen--print {
    grid-column: 7 / span 6;
  }

  .specimen__surface {
    padding: var(--space-lg) var(--inset);
    background: var(--wash);
    box-shadow: inset 0 0 0 1px var(--rule);
  }

  .specimen--web .specimen__surface p {
    max-width: 30em;
  }

  .specimen--print .specimen__surface {
    container-type: inline-size;
    display: grid;
    justify-items: center;
  }

  .page-sheet {
    --sheet: min(100cqi, 19rem);
    width: var(--sheet);
    height: round(up, calc(var(--sheet) * 198 / 129), var(--line));
    padding: 12% 11% 0;
    background: oklch(99% 0.004 90);
    box-shadow:
      inset 0 0 0 1px var(--rule),
      0 1px 2px oklch(21% 0.012 285 / 0.08);
  }

  .page-sheet p {
    top: 0;
    font-size: 10pt;
    line-height: 13pt;
    text-align: justify;
    hyphens: auto;
    text-wrap: wrap;
    color: #000;
  }

  .specimen__title {
    font-size: var(--step-1);
    font-weight: 700;
    --lh: var(--lh-big);
    margin-block-end: var(--space-xs);
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xs) var(--gutter);
    font-size: var(--step--1);
  }

  .specs dt {
    color: var(--ink-muted);
  }

  .specs dd {
    font-weight: 600;
  }

  .data {
    margin-block-start: var(--space-xl);
    row-gap: var(--space-md);
  }

  .data__title {
    grid-column: 1 / span 3;
    font-size: var(--step-1);
    --lh: var(--lh-big);
    max-width: 14ch;
  }

  .data__table {
    grid-column: 4 / span 9;
    border-collapse: collapse;
  }

  .data__table th,
  .data__table td {
    --nudge-px: round(nearest, var(--nudge), 1px);
    top: 0;
    padding: var(--nudge-px) var(--gutter) calc(var(--line) - var(--nudge-px)) 0;
    box-shadow: inset 0 1px 0 var(--rule);
    text-align: start;
    vertical-align: top;
  }

  .data__table thead th {
    box-shadow: none;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .data + .data {
    margin-block-start: var(--space-xl);
  }

  .data__table--numbers tbody th {
    width: auto;
  }

  .data__note {
    grid-column: 4 / span 7;
    max-width: 32em;
    color: var(--ink-muted);
  }

  .data__table tbody th {
    width: 38%;
    font-weight: 600;
  }

  .families {
    list-style: none;
    padding: 0;
    row-gap: var(--space-xl);
  }

  .family,
  .tool,
  .verdict {
